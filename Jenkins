pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate HTML') {
            steps {
                bat '''
                curl -H "Content-Type: text/html; charset=utf-8" ^
                --data-binary @index.html ^
                https://validator.w3.org/nu/?out=text
                '''
            }
        }

        stage('Deploy') {
            steps {
                bat 'echo Deployment successful'
            }
        }
    }
}
