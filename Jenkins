pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'echo Building website'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                mkdir C:\\DeployDemo 2>NUL
                xcopy * C:\\DeployDemo /E /Y
                '''
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful'
        }
    }
}
