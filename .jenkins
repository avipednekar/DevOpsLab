pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Fetching source code'
            }
        }

        stage('Build') {
            steps {
                bat 'echo Building Website'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                mkdir C:\\DeployDemo 2>NUL
                xcopy * C:\\DeployDemo /E /Y
                '''
            }
        }

        stage('Verify') {
            steps {
                bat 'dir C:\\DeployDemo'
            }
        }
    }
}
